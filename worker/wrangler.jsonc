{
  // yataverse-bytes — the yataverse.com bytes-plane Worker (AWAI-3102).
  // Owner decision 2026-11-17: the bytes plane uses yataverse.com hosts (kotobase is a
  // library name, not a host); Cloudflare may be used; blocks are stored in Backblaze B2.
  // No R2, KV, D1 or Durable Objects (ADR 0031 D1).
  //
  // NOT DEPLOYED by merging this file. Deploying adds the `yataverse.com` custom domain
  // (a production DNS record) and needs the owner's approval plus these secrets:
  //   wrangler secret put B2_ENDPOINT          e.g. https://s3.us-west-004.backblazeb2.com
  //   wrangler secret put B2_BUCKET
  //   wrangler secret put B2_KEY_ID            an application key scoped to that bucket
  //   wrangler secret put B2_APP_KEY
  //   wrangler secret put WRITE_TOKEN_SHA256   comma-separated SHA-256 hex of write tokens
  //   wrangler secret put RECEIPT_SIGNING_KEY  Ed25519 private JWK {kty, crv, d, x} (AWAI-3305).
  //                                            Its keyId must be in RECEIPT_PUBLIC_KEYS below, or
  //                                            writes fail closed with 503.
  // Deploy with `wrangler deploy --var SOURCE_COMMIT:<merged main commit>`; the commit is part of
  // the policy each receipt names.
  "name": "yataverse-bytes",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "yataverse.com", "custom_domain": true }
  ],
  "vars": {
    // Object key = B2_PREFIX + CID. "ipld/" matches the earlier graph layout in B2.
    "B2_PREFIX": "ipld/",
    // Largest block accepted or served, in bytes (16 MiB).
    "MAX_BLOCK_BYTES": "16777216",
    // Read tier used only when B2 has no copy: the existing self-hosted Reader
    // (JUN-228). Its bytes are verified against the CID like every other read.
    "READ_FALLBACK_URL": "https://ipfs.yataverse.com",
    // Awai Drive packs (/awai-drive/v1/packs/<sha256>): the Drive WebView origin allowed by
    // CORS (comma-separated) and the largest pack accepted (12 MiB, Drive's CAR bound).
    "DRIVE_ALLOWED_ORIGINS": "http://tauri.localhost",
    "DRIVE_MAX_PACK_BYTES": "12582912",
    // Web origins allowed by CORS on /ipfs (comma-separated, AWAI-3274): the Nagare WebView.
    // Browsers from these origins may POST /ipfs (CAR, still with a write token) and GET/HEAD
    // /ipfs/<cid>. A write with any other Origin header is refused with 403.
    "IPFS_ALLOWED_ORIGINS": "https://tauri.localhost",
    // Read-only CORS origins on GET/HEAD /ipfs/<cid> (AWAI-3472): Tauri WebViews that read public
    // blocks (http://tauri.localhost on Android without useHttpsScheme, tauri://localhost on
    // macOS/iOS) and the GitHub Pages origin for the Itonami market viewer (JUN-1365).
    // These origins get no CORS answer on POST /ipfs, and a PUT/POST carrying one of them
    // Origin headers is refused with 403, as for any origin outside IPFS_ALLOWED_ORIGINS.
    "IPFS_READ_ORIGINS": "http://tauri.localhost, tauri://localhost, https://network-awai.github.io",
    // Per-person CAR writes by ATProto service auth (AWAI-3274, worker/src/service-auth.mjs; owner
    // decision 2026-11-18). The JWT's aud must equal SERVICE_AUTH_AUD and its lxm
    // com.yataverse.importCar; its issuer's #atproto_pds must be in SERVICE_AUTH_PDS and that PDS
    // must report the repo active. SERVICE_AUTH_DENY_DIDS (comma-separated) revokes a person.
    // Removing SERVICE_AUTH_AUD turns the scheme off (503).
    "SERVICE_AUTH_AUD": "did:web:yataverse.com",
    "SERVICE_AUTH_PDS": "https://pds.aozora.app",
    "SERVICE_AUTH_DENY_DIDS": "",
    // PDS-attested tokens (AWAI-3370): "<pds did:web>=<secp256k1 Multikey>", comma-separated. The
    // PDS signs {iss: its DID, sub: member DID} with SERVICE_AUTH_SIGNING_KEY; pin its public half
    // here when that key is provisioned. Empty: no PDS attestation is accepted.
    "SERVICE_AUTH_PDS_KEYS": "",
    "PLC_DIRECTORY_URL": "https://plc.directory",
    // Published receipt signing keys (/.well-known/yataverse-receipt-keys.json, did:web:yataverse.com).
    // keyId = sha256(0xed01 || public key). Times are Unix milliseconds. Rotation: add a key with
    // keyEpoch + 1, set notAfter on the old one and keep it listed; revocation sets revokedAt.
    "RECEIPT_PUBLIC_KEYS": {
      "v": 1,
      "signer": "did:web:yataverse.com",
      "keys": [
        {
          "keyId": "0xad062e68a246d01a369edc6d3713cbbc737b8469208796e52b8c6e943e92eafc",
          "keyEpoch": 1,
          "alg": "Ed25519",
          "publicKeyJwk": { "kty": "OKP", "crv": "Ed25519", "x": "tG9ponOv0_BqWPLw0xpBd9JPKZpImv2yWbT3G7SXdy4" },
          "notBefore": 1794957496429,
          "notAfter": null,
          "revokedAt": null
        }
      ]
    }
  },
  // Per-client write budgets (AWAI-3160, worker/src/write-limits.mjs). The window may only be
  // 10 or 60 seconds; counters are per Cloudflare location. namespace_id must be unique in the account.
  "ratelimits": [
    { "name": "WRITE_REQUEST_LIMITER", "namespace_id": "3160001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_MIB_LIMITER", "namespace_id": "3160002", "simple": { "limit": 64, "period": 60 } }
  ],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }
}
